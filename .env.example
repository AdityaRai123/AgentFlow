# CORS - comma-separated list of front-end origins allowed to call the API.
# Use "*" only for local development; credentials are disabled when it is set.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Accounts - this email becomes admin on signup (else the first account does)
ADMIN_EMAIL=
# Public "Try the live demo" login, capped per hour to protect the Gemini quota
DEMO_ENABLED=true
DEMO_MAX_WORKFLOWS_PER_HOUR=10

# Application
APP_NAME=AgentFlow AI
# DEBUG=true forces ALL scrapers into synthetic demo mode. Keep it false
# for real data collection.
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API (optional)
# With a key, the official Data API v3 is used. Without one the scraper
# falls back to innertube - youtube.com's own JSON API - which needs no
# credentials, so live YouTube data works either way.
YOUTUBE_API_KEY=

# Reddit API
# Reddit blocks unauthenticated access, so live Reddit collection needs an app:
#   1. Go to https://www.reddit.com/prefs/apps -> "create another app..."
#   2. Choose type "script", set redirect uri to http://localhost:8000
#   3. CLIENT_ID is the string under the app name; CLIENT_SECRET is "secret"
# Without these, the Reddit scraper returns synthetic data flagged is_mock=true.
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=AgentFlow/1.0 (by /u/your_reddit_username)

# ChromaDB / RAG
# Embeddings use Gemini (gemini-embedding-001) and require GEMINI_API_KEY.
CHROMA_PERSIST_DIR=./chroma_data
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=10
RAG_MIN_SIMILARITY=0.35

# Agent workflow
# How many times the reviewer may send a report back before auto-approving.
MAX_REPORT_REVISIONS=2

# Scrapers
# Set false to make a source failure raise instead of returning synthetic data.
ALLOW_MOCK_DATA=true

# MLflow - every workflow run is logged as an experiment run.
# Defaults to a local ./mlruns file store when no server is running.
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_ENABLED=true

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
